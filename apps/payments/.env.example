# Vendorizado de BelaBet/vc (stone-split-service). Preencha com as
# credenciais da SUA conta Stone/Pagar.me — nunca comite valores reais.

# Chave secreta — use sk_test_... para testar, sk_live_... em produção.
PAGARME_SECRET_KEY=sk_test_coloque_sua_chave_aqui

# Recipient da PLATAFORMA (conta que recebe a taxa de 9,9%+R$2,49 / 20% em
# todo depósito com split — compartilhada entre todos os seus projetos).
PAGARME_PLATFORM_RECIPIENT_ID=re_coloque_o_recipient_da_plataforma

# Recipient do BetCore em si (o "produtor" no modelo Hotmart) — recebe o
# valor líquido do depósito, descontada a taxa da plataforma e a comissão
# de afiliado (se houver). Crie via POST /recipients.
BETCORE_PRODUCER_RECIPIENT_ID=re_coloque_o_recipient_do_betcore

PAGARME_API_BASE_URL=https://api.pagar.me/core/v5
PAGARME_WEBHOOK_SECRET=coloque_o_segredo_do_webhook_aqui

# Porta deste serviço (server.ts)
PORT=3334

# Onde chamar de volta quando um pagamento é confirmado/falha/estorna.
BETCORE_API_URL=http://localhost:3333
BETCORE_INTERNAL_SECRET=dev-only-change-me
